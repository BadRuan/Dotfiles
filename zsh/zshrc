# ==========================================
# ZSH 配置文件 (Managed by dotfiles)
# ==========================================

# ---------- Powerlevel10k 即时提示（加速启动） ----------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---------- Oh-My-Zsh 基础配置 ----------
export ZSH="$HOME/.oh-my-zsh"
export HISTSIZE=1000000000
export SAVEHIST=$HISTSIZE

setopt EXTENDED_HISTORY
setopt autocd
autoload -U compinit; compinit

# ---------- 主题 ----------
ZSH_THEME="powerlevel10k/powerlevel10k"

# ---------- 插件 ----------
plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
    zsh-autocomplete
    z
)

# 加载 Oh-My-Zsh
source $ZSH/oh-my-zsh.sh

# ---------- Zinit 插件管理器 ----------
# 优先使用国内镜像（gitee），回退到国际源（github）
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}正在安装 Zinit 插件管理器...%f%b"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone --depth=1 https://gitee.com/ruanfumin/zinit.git "$HOME/.local/share/zinit/zinit.git" 2>/dev/null || \
    command git clone --depth=1 https://github.com/zdharma-continuum/zinit.git "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Zinit 安装成功%f%b" || \
        print -P "%F{160} Zinit 安装失败%f%b"
fi

[[ -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]] && source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"

# ---------- Powerlevel10k 配置 ----------
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ---------- 加载 ~/.profile ----------
[[ -f ~/.profile ]] && source ~/.profile
