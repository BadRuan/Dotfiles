# ==========================================
# ZSH 配置文件 (Managed by dotfiles)
# ==========================================

# ---------- Powerlevel10k 即时提示（加速启动） ----------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---------- Oh-My-Zsh 基础配置 ----------
export ZSH="$HOME/.oh-my-zsh"
# 历史记录：10 万条足够日常使用；设置过大只会拖慢 shell 启动、浪费内存与磁盘
export HISTSIZE=100000
export SAVEHIST=$HISTSIZE

setopt EXTENDED_HISTORY
setopt autocd
# 补全初始化：正常由 Oh-My-Zsh 内部统一调用 compinit，
# 这里仅在缺失 Oh-My-Zsh 时兜底，避免重复执行 compinit 拖慢启动。
if [[ ! -f "$ZSH/oh-my-zsh.sh" ]]; then
  autoload -U compinit; compinit
fi

# ---------- 主题 ----------
ZSH_THEME="powerlevel10k/powerlevel10k"

# ---------- 插件 ----------
plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
    z
    zsh-autocomplete
)

# 加载 Oh-My-Zsh（未安装时给出提示，不报错中断）
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
else
    print -P "%F{220}[dotfiles] 未检测到 Oh-My-Zsh（$ZSH）。%f"
    print -P "%F{220}[dotfiles] 请运行一键安装脚本完成全部组件安装：%f"
    print -P '%F{33}  sh -c "$(curl -fsSL https://gitee.com/ruanfumin/dotfiles/raw/master/zsh/auto_install_zsh.sh)"%f'
fi

# ---------- Zinit 插件管理器 ----------
# 优先使用国内镜像（gitee），回退到国际源（github）
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}正在安装 Zinit 插件管理器...%f%b"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    if ! command git clone --depth=1 https://gitee.com/ruanfumin/zinit.git "$HOME/.local/share/zinit/zinit.git" 2>/dev/null; then
        # 国内源失败：清理可能的残留目录后回退国际源
        command rm -rf "$HOME/.local/share/zinit/zinit.git"
        command git clone --depth=1 https://github.com/zdharma-continuum/zinit.git "$HOME/.local/share/zinit/zinit.git" 2>/dev/null
    fi
    if [[ -f "$HOME/.local/share/zinit/zinit.git/zinit.zsh" ]]; then
        print -P "%F{33} %F{34}Zinit 安装成功%f%b"
    else
        print -P "%F{160} Zinit 安装失败（国内源与国际源均不可用），可稍后手动安装%f%b"
    fi
fi

[[ -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]] && source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"

# ---------- Powerlevel10k 配置 ----------
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ---------- 加载 ~/.profile ----------
if [[ -f ~/.profile ]]; then
    source ~/.profile
fi
